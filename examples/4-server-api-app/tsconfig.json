{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "shared/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts"
  ]
}
