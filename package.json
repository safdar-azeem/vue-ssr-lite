{
  "name": "vue-ssr-lite",
  "version": "1.0.0",
  "description": "A Server-Side Rendering (SSR) runtime for Vue 3",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "author": "safdar-azeem",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safdar-azeem/vue-ssr-lite.git"
  },
  "homepage": "https://github.com/safdar-azeem/vue-ssr-lite#readme",
  "bugs": "https://github.com/safdar-azeem/vue-ssr-lite/issues",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vue-ssr-lite": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.mjs",
      "default": "./dist/client.mjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "default": "./dist/server.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "default": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:package": "node scripts/SsrPackageSmoke.mjs",
    "prepublishOnly": "npm run build && npm test && npm run test:package",
    "release:rc": "npm version prerelease --preid=rc && npm publish --tag next",
    "release:patch": "npm version patch && npm publish --tag latest",
    "release:minor": "npm version minor && npm publish --tag latest",
    "release:major": "npm version major && npm publish --tag latest"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@vercel/nft": "^1.11.0",
    "es-module-lexer": "^2.3.1",
    "esbuild": "^0.27.0 || ^0.28.0"
  },
  "peerDependencies": {
    "vite": "^7.0.0",
    "vue": "~3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^29.0.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5",
    "vue": "~3.5.40",
    "vue-router": "^4.6.4"
  },
  "resolutions": {
    "vite": "7.3.6"
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2,
    "endOfLine": "auto",
    "bracketSameLine": true
  }
}
